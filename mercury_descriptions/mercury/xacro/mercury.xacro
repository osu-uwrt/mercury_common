<?xml version="1.0"?>
<robot name="mercury" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="namespace" default="mercury" />
    <xacro:arg name="use_zed_camera" default="false" />
    <xacro:arg name="zed_xacro_path" default="" />
    <xacro:arg name="sim_enabled" default="false" />
    <!-- Include the Robot macro file -->
    <xacro:include filename="$(find mercury_descriptions)/mercury/xacro/mercury_base.xacro" />

    <!-- Read the config -->
    <xacro:property name="yaml_file" value="$(find mercury_descriptions)/mercury/config/mercury_xacro_frames.yaml" />
    <xacro:property name="config" value="${xacro.load_yaml(yaml_file)}" />
    <!-- <xacro:property name="body_file" value="package://riptide_descriptions2/meshes/mercury.dae"/> -->
    <!-- <xacro:property name="prop_file" value="package://riptide_descriptions2/meshes/Propeller.dae"/> -->

    <!-- Create robot -->
    <xacro:robot_base
        namespace="$(arg namespace)"
        config="${config}" />

    <xacro:if value="$(arg sim_enabled)">
        <xacro:include filename="$(find mercury_descriptions)/mercury/xacro/mercury_sim.xacro" />
        <xacro:sim_setup 
            namespace="$(arg namespace)" />
    </xacro:if>    

</robot>
