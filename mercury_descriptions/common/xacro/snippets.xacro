<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Thrusters -->
    <xacro:macro name="single_thruster_macro" params="namespace
        thruster_id
        *origin">

        <joint name="${namespace}/thruster_${thruster_id}_joint" type="fixed">
            <xacro:insert_block name="origin" />
            <!-- <axis xyz="1 0 0" /> -->
            <parent link="${namespace}/base_link" />
            <child link="${namespace}/thruster_${thruster_id}" />
        </joint>

        <link name="${namespace}/thruster_${thruster_id}">
            <visual>
                <geometry>
                    <mesh filename="package://riptide_descriptions2/meshes/Propeller.dae" scale="1 1 1" />
                </geometry>
            </visual>
        </link>
    </xacro:macro>

    <xacro:macro name="all_thrusters_macro" params="namespace thrusters index">
        <xacro:if value="${thrusters != []}">
            <xacro:property name="thruster" value="${thrusters[0]}"/>
            <xacro:single_thruster_macro
                namespace="${namespace}"
                thruster_id="${index}">
                <origin xyz="${thruster['pose'][0]} ${thruster['pose'][1]} ${thruster['pose'][2]}"
                        rpy="${thruster['pose'][3]} ${thruster['pose'][4]} ${thruster['pose'][5]}"/>
            </xacro:single_thruster_macro>
            <xacro:all_thrusters_macro
                namespace="${namespace}"
                thrusters="${thrusters[1:]}"
                index="${index+1}"/>
        </xacro:if>
  </xacro:macro>

    <!-- IMU -->
    <xacro:macro name="imu_macro" params="namespace imu_suffix parent_link config">
        <xacro:if value="${'imu' in config}">
            <link name="${namespace}/imu${imu_suffix}_link" />

            <xacro:property name="imu" value="${config['imu']}" />

            <joint name="${namespace}/imu${imu_suffix}_joint" type="fixed">
                <origin xyz="${imu['pose'][0]} ${imu['pose'][1]} ${imu['pose'][2]}"
                        rpy="${imu['pose'][3]} ${imu['pose'][4]} ${imu['pose'][5]}" />
                <parent link="${parent_link}" />
                <child link="${namespace}/imu${imu_suffix}_link" />
            </joint>
        </xacro:if>
    </xacro:macro>

    <!-- Depth Sensor-->
    <xacro:macro name="depth_macro" params="namespace parent_link config">
        <xacro:if value="${'depth' in config}">
            <link name="${namespace}/depth_link" />

            <xacro:property name="depth" value="${config['depth']}"/>

            <joint name="${namespace}/depth_joint" type="fixed">
                <origin xyz="${depth['pose'][0]} ${depth['pose'][1]} ${depth['pose'][2]}"
                        rpy="${depth['pose'][3]} ${depth['pose'][4]} ${depth['pose'][5]}" />
                <parent link="${parent_link}" />
                <child link="${namespace}/depth_link" />
            </joint>
        </xacro:if>
    </xacro:macro>

    <!-- Cameras -->
    <xacro:macro name="cameras_macro" params="namespace parent_link cameras">
        <xacro:if value="${cameras != []}">
            <xacro:property name="camera" value="${cameras[0]}"/>
            <xacro:property name="camera_base_link" value="${namespace}/${camera['name']}_base_link"/>

            <link name="${camera_base_link}" />

            <joint name="${camera_base_link}_joint" type="fixed">
                <parent link="${parent_link}"/>
                <child link="${camera_base_link}"/>
                <origin xyz="${camera['pose'][0]} ${camera['pose'][1]} ${camera['pose'][2]}" 
                        rpy="${camera['pose'][3]} ${camera['pose'][4]} ${camera['pose'][5]}"/>
            </joint>

            <!-- Stereo Camera(s) -->
            <xacro:if value="${camera['type'] == 'stereo'}">
                <xacro:stereo_macro
                    namespace="${namespace}"
                    parent_link="${namespace}/${camera['name']}_base_link" 
                    name="${camera['name']}"
                    baseline="${camera['baseline']}">
                    <origin xyz="0 ${camera['baseline'] / 2} 0" />
                </xacro:stereo_macro>
            </xacro:if>
        </xacro:if>
    </xacro:macro>
</robot>
